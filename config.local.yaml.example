env: "local"
port: 8080
# logLevel juga menentukan seberapa banyak GORM mencatat kueri:
#
#   DEBUG        -> SETIAP kueri, LENGKAP DENGAN NILAI YANG DIIKAT. Nilai itu
#                   adalah isi tabel: NIP, nama pegawai, nama berkas, alamat IP.
#                   Berguna saat menelusuri di mesin sendiri; JANGAN dipakai di
#                   server bersama.
#   selain DEBUG -> hanya kueri lambat (>200 ms) dan error basis data.
#
# Berkas ini kerap menjadi satu-satunya titik awal saat orang menyusun config
# baru — termasuk untuk server — jadi bawaannya dibuat yang aman. Nyalakan DEBUG
# secara sadar saat memang dibutuhkan.
logLevel: "INFO"

# logMode false membungkam GORM SEPENUHNYA, termasuk error basis data dan kueri
# lambat. Biarkan true; kedalamannya diatur lewat logLevel di atas.
logMode: true
logFormat: "text"

# Database configuration
postgres:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "password"
  dbname: "gin_boilerplate"
  sslmode: "disable"
  timezone: "UTC"

# Redis configuration (optional)
redis:
  enableRedis: false
  host: "localhost"
  port: 6379
  password: ""
  db: 0

# Rate limiting
rate: 100
interval: "1m"

# JWT configuration
secretKey: "your-secret-key-change-this-in-production"
accessTokenExpiry: 24
accessTokenExpiryUnit: "hour"

# HTTP timeout
httpTimeout: "30s"
