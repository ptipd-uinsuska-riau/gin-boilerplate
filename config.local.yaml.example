env: "local"
port: 8080
logLevel: "DEBUG"
logMode: true
logFormat: "text"

# Database configuration
postgres:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "password"
  dbname: "gin_boilerplate"
  sslmode: "disable"
  timezone: "UTC"

# Redis configuration (optional)
redis:
  enableRedis: false
  host: "localhost"
  port: 6379
  password: ""
  db: 0

# Rate limiting
rate: 100
interval: "1m"

# JWT configuration
secretKey: "your-secret-key-change-this-in-production"
accessTokenExpiry: 24
accessTokenExpiryUnit: "hour"

# HTTP timeout
httpTimeout: "30s"
